# Environment variables — see docs/security-model.md and CLAUDE.md.
# All variables are validated at application startup (spec §53).
# Never commit real values. NEXT_PUBLIC_* vars are the ONLY ones allowed
# in browser bundles — everything else is server-only.

# --- Supabase (client-visible) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (server-only — never expose to the browser) ---
SUPABASE_SECRET_KEY=

# --- Application ---
NEXT_PUBLIC_APP_URL=

# --- Sentry ---
# NEXT_PUBLIC_SENTRY_DSN: the project's DSN from Sentry (Settings > Client
# Keys (DSN)). Client-visible by design — a DSN is a write-only ingestion
# address, not a secret; it's the only thing the browser SDK needs.
# Optional: the app runs fine with it unset (Sentry.init no-ops without a
# DSN) — see docs/decisions.md ADR-013/ADR-018.
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN: a Sentry auth token (Settings > Auth Tokens) with
# `project:releases` and `org:read` scopes, used ONLY at `next build` time
# by next.config.ts to upload source maps. Server/build-only — never
# reference this with a NEXT_PUBLIC_ prefix, never log it, never let it
# reach a Sentry event (the sanitizer strips anything header/tag-shaped
# that looks like it, but the real control is not needing to touch it in
# app code at all). Required for readable stack traces in Preview/
# Production; source map upload is skipped with a warning if unset.
SENTRY_AUTH_TOKEN=
# SENTRY_ORG / SENTRY_PROJECT: the Sentry organization and project slugs
# (from the project's Settings page URL), used alongside SENTRY_AUTH_TOKEN
# for source map upload. Server/build-only.
SENTRY_ORG=
SENTRY_PROJECT=

# --- Email (server-only) ---
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# --- CRM integration (server-only) ---
CRM_CLIENT_ID=
CRM_CLIENT_SECRET=
CRM_REDIRECT_URI=

# --- Geocoding / location normalization (server-only) ---
GEOCODING_PROVIDER_KEY=

# --- Webhook secret encryption (server-only; see docs/decisions.md ADR-003) ---
WEBHOOK_ENCRYPTION_KEY=

# --- Internal Cron-to-app authentication (server-only; see docs/decisions.md ADR-042) ---
CRON_SECRET=

# --- Playwright end-to-end tests (see tests/e2e/README.md) ---
# Test-only values pointing at a seeded Supabase project; never set these
# for a real deployment. Not read by the app itself, only by
# playwright.config.ts and tests/e2e/*.
E2E_BASE_URL=
E2E_ORG_SLUG=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
